<?xml version="1.0" encoding="UTF-8"?>
<!--
  RT-GSFit settings for the analytic test case (no external data needed).

  A circular plasma of radius rho_b = 0.5 m at R = 10 m carrying 1 MA, measured by flux loops,
  Bp probes and Rogowski coils. The same measurements are replayed at every time slice, so the
  time slices are iterations converging on the exact solution in
  rtgsfit.database_readers.analytic.solution. psi is in Wb/rad for this case.
-->
<parameters>
  <preshot>
    <reader type="str" description="where the preshot comes from">analytic</reader>
    <boundary>
      <xpt_fraction type="float" description="when diverted, boundary_psi = xpt_fraction xpt_psi[0] + (1 - xpt_fraction) axis_psi, just inside the separatrix so the flood fill does not leak through the x-point">0.99</xpt_fraction>
      <tolerance type="float" unit="Wb/rad" description="minimum |axis_psi - boundary_psi|, and minimum |Hessian determinant| of a magnetic null">1e-10</tolerance>
      <ip_min type="float" unit="A" description="the current centroid is only computed above this plasma current">1000.0</ip_min>
      <n_xpt_max type="int" description="maximum number of x-points returned">50</n_xpt_max>
    </boundary>
  </preshot>

  <signals>
    <reader type="str" description="where the measurements come from">analytic</reader>
  </signals>

  <replay>
    <pulse type="int">0</pulse>
    <time_start type="float" unit="s">0.0</time_start>
    <time_end type="float" unit="s">0.009</time_end>
    <time_step type="float" unit="s">0.001</time_step>
    <repeat type="int" description="calls of rtgsfit() per time slice; above 1 to study convergence at fixed times">1</repeat>
    <stop_on_status type="bool" description="stop the replay at the first non-zero status">false</stop_on_status>
    <stop_below_ip type="float" unit="A" description="stop the replay when |ip| falls below this (0 to disable)">0.0</stop_below_ip>
  </replay>

  <build>
    <timing type="bool" description="compile the per-section timers">false</timing>
    <arch_flags type="str">-march=native</arch_flags>
  </build>

  <writers>
    <names type="str_array" description="database writers to run after the replay">local</names>
    <local>
      <path type="str" description="output file (.npz)">rtgsfit_analytic.npz</path>
    </local>
  </writers>

  <analytic>
    <plasma>
      <r_0 type="float" unit="m">10.0</r_0>
      <z_0 type="float" unit="m">0.0</z_0>
      <rho_b type="float" unit="m" description="plasma minor radius">0.5</rho_b>
      <ip type="float" unit="A">1000000.0</ip>
    </plasma>
    <grid>
      <r_min type="float" unit="m">9.25</r_min>
      <r_max type="float" unit="m">10.75</r_max>
      <n_r type="int">65</n_r>
      <z_min type="float" unit="m">-1.5</z_min>
      <z_max type="float" unit="m">1.5</z_max>
      <n_z type="int">129</n_z>
    </grid>
    <limiter description="points on a rectangle">
      <r_min type="float" unit="m">9.5</r_min>
      <r_max type="float" unit="m">10.5</r_max>
      <n_r type="int">50</n_r>
      <z_min type="float" unit="m">-1.0</z_min>
      <z_max type="float" unit="m">1.0</z_max>
      <n_z type="int">100</n_z>
    </limiter>
    <flux_loops description="points on a rectangle">
      <r_min type="float" unit="m">9.4</r_min>
      <r_max type="float" unit="m">10.6</r_max>
      <n_r type="int">4</n_r>
      <z_min type="float" unit="m">-1.2</z_min>
      <z_max type="float" unit="m">1.2</z_max>
      <n_z type="int">8</n_z>
    </flux_loops>
    <bp_probes description="points on the sides of a rectangle, excluding the corners">
      <r_min type="float" unit="m">9.4</r_min>
      <r_max type="float" unit="m">10.6</r_max>
      <n_r type="int">5</n_r>
      <z_min type="float" unit="m">-1.2</z_min>
      <z_max type="float" unit="m">1.2</z_max>
      <n_z type="int">10</n_z>
    </bp_probes>
    <passives description="filaments">
      <r type="float_array" unit="m">9.45 10.0 10.55 10.0</r>
      <z type="float_array" unit="m">0.0 1.1 0.0 -1.1</z>
    </passives>
    <initial description="initial psi_norm: a cosine bump, deliberately off-centre">
      <r type="float" unit="m">10.2</r>
      <z type="float" unit="m">0.5</z>
      <radius type="float" unit="m">0.25</radius>
    </initial>
  </analytic>
</parameters>
