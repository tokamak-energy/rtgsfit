<?xml version="1.0" encoding="UTF-8"?>
<!--
  RT-GSFit settings for a MAST-U-like machine with synthetic measurements from FreeGSNKE.

  The example of a machine other than ST40; it needs GSFit and FreeGSNKE, but no Tokamak Energy
  network. FreeGSNKE solves a diverted equilibrium, GSFit (`mastu_with_synthetic_data_from_freegsnke`)
  turns the machine description into the preshot and reads the synthetic measurements, and the
  same measurements are replayed at every time slice, so the time slices are iterations converging
  on the FreeGSNKE equilibrium. Every GSFit PF coil is an RT-GSFit coil (no `gsfit/coils`).
-->
<parameters>
  <preshot>
    <reader type="str" description="where the preshot comes from">freegsnke</reader>
    <boundary>
      <xpt_fraction type="float" description="when diverted, boundary_psi = xpt_fraction xpt_psi[0] + (1 - xpt_fraction) axis_psi, just inside the separatrix so the flood fill does not leak through the x-point">0.999</xpt_fraction>
      <tolerance type="float" unit="Wb" description="minimum |axis_psi - boundary_psi|, and minimum |Hessian determinant| of a magnetic null">1e-10</tolerance>
      <ip_min type="float" unit="A" description="the current centroid is only computed above this plasma current">1000.0</ip_min>
      <n_xpt_max type="int" description="maximum number of x-points returned">50</n_xpt_max>
    </boundary>
  </preshot>

  <signals>
    <reader type="str" description="where the measurements come from">freegsnke</reader>
  </signals>

  <replay>
    <pulse type="int">0</pulse>
    <time_start type="float" unit="s">0.0</time_start>
    <time_end type="float" unit="s">0.019</time_end>
    <time_step type="float" unit="s">0.001</time_step>
    <repeat type="int" description="calls of rtgsfit() per time slice; above 1 to study convergence at fixed times">1</repeat>
    <stop_on_status type="bool" description="stop the replay at the first non-zero status">false</stop_on_status>
    <stop_below_ip type="float" unit="A" description="stop the replay when |ip| falls below this (0 to disable)">0.0</stop_below_ip>
  </replay>

  <build>
    <timing type="bool" description="compile the per-section timers">true</timing>
    <arch_flags type="str">-march=native</arch_flags>
  </build>

  <writers>
    <names type="str_array" description="database writers to run after the replay">local</names>
    <local>
      <path type="str" description="output file (.npz)">rtgsfit_freegsnke.npz</path>
      <preshot_path type="str">rtgsfit_freegsnke_preshot.npz</preshot_path>
    </local>
  </writers>

  <freegsnke>
    <machine_dir type="str" description="FreeGSNKE machine pickles">~/github/freegsnke/machine_configs/MAST-U</machine_dir>
    <machine_prefix type="str" description="file name prefix of the pickles">MAST-U_like_</machine_prefix>
    <currents_path type="str" description="pickled {coil: current [A]}">~/github/freegsnke/examples/data/simple_diverted_currents_PaxisIp.pk</currents_path>
    <grid>
      <r_min type="float" unit="m">0.1</r_min>
      <r_max type="float" unit="m">2.0</r_max>
      <z_min type="float" unit="m">-2.2</z_min>
      <z_max type="float" unit="m">2.2</z_max>
      <n_r type="int">65</n_r>
      <n_z type="int">129</n_z>
    </grid>
    <profile description="freegsnke.jtor_update.ConstrainPaxisIp">
      <p_axis type="float" unit="Pa">8000.0</p_axis>
      <ip type="float" unit="A">600000.0</ip>
      <f_vacuum type="float" unit="T.m">0.5</f_vacuum>
      <alpha_m type="float">1.8</alpha_m>
      <alpha_n type="float">1.2</alpha_n>
    </profile>
    <tolerance type="float" description="FreeGSNKE target relative tolerance">1e-9</tolerance>
  </freegsnke>

  <gsfit>
    <settings_path type="str">mastu_with_synthetic_data_from_freegsnke</settings_path>
    <sensor_names type="str" description="gsfit: QUANTITY_SENSOR, e.g. PSI_F_BL_01">gsfit</sensor_names>
    <initial>
      <source type="str" description="cosine_bump: psi_norm = 0 at (r, z), 1 at radius">cosine_bump</source>
      <r type="float" unit="m">0.9</r>
      <z type="float" unit="m">0.0</z>
      <radius type="float" unit="m">0.4</radius>
    </initial>
  </gsfit>
</parameters>
